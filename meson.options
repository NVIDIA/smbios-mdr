option('tests', type: 'feature', value: 'enabled', description: 'Build tests')

option(
    'dimm-dbus',
    type: 'feature',
    value: 'enabled',
    description: 'Expose DIMM D-Bus Interface',
)

option(
    'dimm-only-locator',
    type: 'feature',
    value: 'disabled',
    description: 'Only use the DIMM number, and not the bank',
)

option(
    'assoc-trim-path',
    type: 'feature',
    value: 'disabled',
    description: 'Trim one object path component from CPU and DIMM associations',
)

option(
    'cpuinfo',
    type: 'feature',
    value: 'enabled',
    description: 'Build CPUInfo service',
)

option(
    'slot-drive-presence',
    type: 'feature',
    value: 'disabled',
    description: 'Sets drive presence on slot objects',
)

option(
    'cpuinfo-peci',
    type: 'feature',
    value: 'enabled',
    description: 'Enable CPUInfo features that depend on PECI',
)

option(
    'smbios-ipmi-blob',
    type: 'feature',
    value: 'enabled',
    description: 'Build IPMI blob library for SMBIOS transfer',
)

option(
    'pcie-device-dbus',
    type: 'feature',
    value: 'disabled',
    description: 'Expose PCIeDevice D-Bus objects from SMBIOS Type 9 slots',
)

option(
    'tpm-dbus',
    type: 'feature',
    value: 'disabled',
    description: 'Expose TPM D-Bus Interface',
)

option(
    'firmware-inventory-dbus',
    type: 'feature',
    value: 'disabled',
    description: 'Expose Firmware Inventory D-Bus Interface',
)

option(
    'expose-firmware-component-name',
    type: 'feature',
    value: 'disabled',
    description: 'Use Firmware Component value as dbus object path',
)

option(
    'custom-dbus-path',
    type: 'feature',
    value: 'disabled',
    description: 'Use the Custom DBus object path for Inventory',
)

option(
    'cpu-dbus',
    type: 'feature',
    value: 'enabled',
    description: 'Expose CPU D-Bus Interface',
)

option(
    'cpu-dbus-chassisiface',
    type: 'feature',
    value: 'enabled',
    description: 'Add Chassis Interface into CPU D-Bus',
)

option(
    'copy-cpu-version-to-model',
    type: 'boolean',
    value: 'false',
    description: 'Copy CPU version to model property',
)

option(
    'dimm-location-code',
    type: 'feature',
    value: 'enabled',
    description: 'Expose DIMM LocationCode D-Bus interface and enable related features',
)

option(
    'expose-inventory',
    type: 'boolean',
    value: 'false',
    description: 'Process Type 45 and report fw version',
)

option(
    'firmware-component-name-bmc',
    type: 'string',
    value: '',
    description: 'BMC firmware component name in Type 45, it is used to avoid duplicated version object',
)

option(
    'firmware-component-name-bios',
    type: 'string',
    value: '',
    description: 'BIOS firmware component name in Type 45, it is used to avoid duplicated version object',
)

option(
    'firmware-component-name-tpm',
    type: 'string',
    value: '',
    description: 'TPM firmware component name in Type 45, it is used to avoid duplicated version object',
)

option(
    'firmware-component-name-nic',
    type: 'string',
    value: '',
    description: 'NIC firmware component name in Type 45, it is used to avoid duplicated version object',
)

option(
    'firmware-component-name-fpga',
    type: 'string',
    value: '',
    description: 'FPGA firmware component name in Type 45, it is used to avoid duplicated version object',
)

option(
    'nvidia',
    type: 'boolean',
    value: 'false',
    description: 'Enable NVIDIA features',
)

option(
    'platform-prefix',
    type: 'string',
    value: '',
    description: 'Platform prefix, it prepend to DBus object name, such as ${PLATFORM_PREFIX}_CPU_0',
)

option(
    'procmod-dbus',
    type: 'feature',
    value: 'enabled',
    description: 'Expose Processor Module D-Bus Interface',
)

option(
    'publish-inventory',
    type: 'feature',
    value: 'enabled',
    description: '''Publish parsed SMBIOS records as inventory items on D-Bus.
When disabled, smbiosmdrv2app still receives, persists, and serves raw
SMBIOS records via xyz.openbmc_project.Smbios.MDR_V2 (so smbios-ipmi-blob
and other producers keep working), but creates no inventory objects under
/xyz/openbmc_project/inventory and does not register an ObjectManager
there. Use this on systems where another service (e.g. NvidiaInfo) is the
canonical inventory publisher for that subtree.''',
)
